/node_modules
/oh_modules
/local.properties
/.idea
**/build
/.hvigor
/.cxx
/.clangd
/.clang-format
/.clang-tidy
**/.test
/.appanalyzer

# 签名材料：私钥、证书与**口令**绝不入库
/signing/local.env
/signing/*.p12
/signing/*.csr
/signing/*.cer
/signing/*.p7b
# 发布（上架）用的那套也一样：单独放 signing/release/，材料绝不入库
# （⚠️ 只挡材料文件，不挡该目录的 README.md —— 那个要入库）
/signing/release/*.p12
/signing/release/*.csr
/signing/release/*.cer
/signing/release/*.p7b

# 上架产物（.app）—— 每次都能重新打，不入库
/dist

# 真机联调时抓的运行时日志与截图
/.logs
/.logs-preview-*.jpeg

# 领域逻辑验证
/tools/domain-check/node_modules
/tools/domain-check/.work
/tools/domain-check/dist

# 做图标用的原始素材（游戏截图，含平台水印）：不入库
/特蕾西娅.jpg
/圣聆初雪.jpg

# ---- Dart / Flutter（app_flutter/）----
# .dart_tool 是 pub 的缓存与编译产物，绝不该入库（里面还有几十 MB 的快照）
app_flutter/.dart_tool/
app_flutter/build/
app_flutter/.flutter-plugins
app_flutter/.flutter-plugins-dependencies
app_flutter/ios/Pods/
app_flutter/**/*.iml
.DS_Store
